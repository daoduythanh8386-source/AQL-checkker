{
  "name": "AQL-checkker",
  "productName": "AQL Tra Cứu",
  "version": "1.0.0",
  "description": "AQL Tra Cứu - Oristar",
  "author": "Oristar",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.oristar.aqltracuu",
    "productName": "AQL Tra Cứu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "electron/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
